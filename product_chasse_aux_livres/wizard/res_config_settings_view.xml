<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="product.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <block id="product_general_settings" position="after">
            <block id="chasse_aux_livres" title="Chasse aux Livres">
                <setting id="chasse_aux_livres_default_product_categ_id">
                    <field name="chasse_aux_livres_default_product_categ_id"/>
                </setting>
            </block>
        </block>
    </field>
</record>

</odoo>
